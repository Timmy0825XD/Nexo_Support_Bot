PORT=3000
CORS_ORIGIN=http://localhost:3001

# Shared secret for bot and web server — use a long random value in production
INTERNAL_API_KEY=change-this-internal-api-key-in-production

# Supabase — copy from packages/database/.env.example
DATABASE_URL=
DIRECT_URL=

# Google Sheet with banned player IDs (edit/share link or CSV export URL both work)
# Example: https://docs.google.com/spreadsheets/d/YOUR_SHEET_ID/edit
BANNED_PLAYERS_SHEET_URL=
